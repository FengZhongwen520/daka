{
  "name": "yechao",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "news-api": "node server/news-api.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "serve:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File daka_serve/run-dev.ps1",
    "test:serve": "mvn -f daka_serve/pom.xml test",
    "test:all": "npm run build && npm run test:serve",
    "deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy.ps1",
    "deploy:dry-run": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy.ps1 -DryRun"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  }
}
