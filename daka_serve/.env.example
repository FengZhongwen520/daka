# Base64-encoded 32-byte AES-256 key
DAKA_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# Base64-encoded random value of at least 32 bytes
DAKA_LOOKUP_PEPPER=replace-with-base64-lookup-pepper
DAKA_SERVER_PORT=8080
DAKA_CORS_ORIGINS=http://localhost:5173
# Optional: override the H2 database file
# DAKA_DB_URL=jdbc:h2:file:./data/daka-serve;MODE=PostgreSQL;DB_CLOSE_ON_EXIT=FALSE
# Maximum plaintext value size per record
DAKA_STORAGE_MAX_VALUE_BYTES=12582912

# Optional SMTP settings required for email binding and password recovery
# DAKA_SMTP_HOST=smtp.example.com
# DAKA_SMTP_PORT=587
# DAKA_SMTP_USERNAME=no-reply@example.com
# DAKA_SMTP_PASSWORD=replace-with-smtp-password
# DAKA_SMTP_AUTH=true
# DAKA_SMTP_STARTTLS=true
# DAKA_MAIL_FROM=no-reply@example.com
# DAKA_MAIL_CODE_TTL_SECONDS=600
